---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../content/settings/site.json';
import { u } from '../lib/url';
import fontHead from '@fontsource/bricolage-grotesque/files/bricolage-grotesque-latin-800-normal.woff2?url';
import fontBody from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';

interface Alt { lang: string; href: string }
interface Props {
  title: string;
  description?: string;
  image?: string;
  lang?: string;
  alternates?: Alt[];
  chrome?: boolean;
  jsonld?: Record<string, unknown>;
  noindex?: boolean;
  preloadImage?: string;
}
const {
  title,
  description = site.description,
  image = site.ogImage,
  lang = 'it',
  alternates = [],
  chrome = true,
  jsonld,
  noindex = false,
  preloadImage,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = image ? new URL(u(image), Astro.site).href : undefined;
const ogLocale = { it: 'it_IT', ru: 'ru_RU', en: 'en_GB' }[lang] ?? 'it_IT';

const org = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: site.legalName,
  alternateName: 'ConVoglio',
  slogan: site.motto,
  logo: new URL(u('/brand/bus-480.png'), Astro.site).href,
  url: new URL(u('/'), Astro.site).href,
  email: site.email,
  telephone: site.phone,
  taxID: site.fiscalCode,
  address: { '@type': 'PostalAddress', streetAddress: 'Via Giolitti 21', postalCode: '10123', addressLocality: 'Torino', addressCountry: 'IT' },
  sameAs: [site.facebook, site.instagram].filter(Boolean),
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preload" href={fontHead} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontBody} as="font" type="font/woff2" crossorigin />
    {preloadImage && <link rel="preload" href={u(preloadImage)} as="image" fetchpriority="high" />}
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={new URL(u(a.href), Astro.site).href} />)}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.legalName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && /\/og-[\w-]+\.png$|\/og-image\.png$/.test(image) && <meta property="og:image:width" content="1200" />}
    {ogImage && /\/og-[\w-]+\.png$|\/og-image\.png$/.test(image) && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content={title} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={u('/favicon.ico')} sizes="48x48" />
    <link rel="icon" href={u('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={u('/apple-touch-icon.png')} />
    <link rel="manifest" href={u('/site.webmanifest')} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="sitemap" href={u('/sitemap-index.xml')} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonld ?? org)} />
  </head>
  <body>
    <a class="skip" href="#main">{lang === 'ru' ? 'К содержанию' : lang === 'en' ? 'Skip to content' : 'Vai al contenuto'}</a>
    {chrome && <Header />}
    <main id="main">
      <slot />
    </main>
    {chrome ? <Footer /> : <slot name="footer" />}
  </body>
</html>
