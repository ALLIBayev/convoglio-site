---
/**
 * Decorative stickers taken from the ConVoglio logo (the hearts on the bus, the luggage ribbon).
 * Always aria-hidden: they carry mood, not information.
 */
type Shape = 'heart' | 'star' | 'dot' | 'ring' | 'spark' | 'ticket';
interface Props {
  shape: Shape;
  color?: string;
  size?: number;
  rotate?: number;
  class?: string;
  style?: string;
}
const { shape, color = 'var(--red)', size = 48, rotate = 0, class: cls, style = '' } = Astro.props;
const paths: Record<Shape, string> = {
  heart: '<path d="M24 42S5 30.5 5 17.5C5 11 10 6.5 15.6 6.5c3.7 0 6.6 2 8.4 4.8 1.8-2.8 4.7-4.8 8.4-4.8C38 6.5 43 11 43 17.5 43 30.5 24 42 24 42Z" fill="currentColor" stroke="#fff" stroke-width="3" stroke-linejoin="round"/><path d="M14 15.5c.8-2.2 2.6-3.4 4.6-3.6" stroke="#fff" stroke-width="2.4" stroke-linecap="round" fill="none" opacity=".7"/>',
  star: '<path d="M24 4.5l5.6 11.6 12.7 1.7-9.3 8.8 2.3 12.6L24 33.1l-11.3 6.1L15 26.6l-9.3-8.8 12.7-1.7L24 4.5Z" fill="currentColor" stroke="#fff" stroke-width="3" stroke-linejoin="round"/>',
  dot: '<circle cx="24" cy="24" r="18" fill="currentColor" stroke="#fff" stroke-width="3"/>',
  ring: '<circle cx="24" cy="24" r="16" fill="none" stroke="currentColor" stroke-width="7"/>',
  spark: '<path d="M24 4v12M24 32v12M4 24h12M32 24h12M10 10l7 7M31 31l7 7M38 10l-7 7M17 31l-7 7" stroke="currentColor" stroke-width="5" stroke-linecap="round"/>',
  ticket: '<path d="M6 14a4 4 0 0 1 4-4h28a4 4 0 0 1 4 4v5a5 5 0 0 0 0 10v5a4 4 0 0 1-4 4H10a4 4 0 0 1-4-4v-5a5 5 0 0 0 0-10v-5Z" fill="currentColor" stroke="#fff" stroke-width="3"/><path d="M30 13v22" stroke="#fff" stroke-width="2.4" stroke-dasharray="3 3"/>',
};
---
<svg
  class:list={['sticker', cls]}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  aria-hidden="true"
  focusable="false"
  style={`color:${color};transform:rotate(${rotate}deg);${style}`}
  set:html={paths[shape]}
/>

<style>
  .sticker { position: absolute; pointer-events: none; filter: drop-shadow(0 6px 10px rgba(27, 31, 42, 0.14)); }
</style>
