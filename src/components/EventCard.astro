---
import Media from './Media.astro';
import { u } from '../lib/url';

interface Props {
  id: string;
  data: { title: string; category: string; date: string; image: string; imageAlt: string; imageFit: 'cover' | 'contain'; summary: string };
  tone?: string;
  headingLevel?: 'h2' | 'h3';
  wide?: boolean;
}
const { id, data, tone = 'yellow', headingLevel = 'h2', wide = false } = Astro.props;
const H = headingLevel;
const meta = [data.category, data.date].filter(Boolean);
---
{data.image ? (
  <a class:list={['ecard', wide && 'ecard--wide']} href={u(`/eventi/${id}/`)}>
    <div class="ecard__img"><Media src={data.image} alt={data.imageAlt} fit={data.imageFit} tone={tone} /></div>
    <div class="ecard__body">
      {meta.length > 0 && <p class="ecard__meta">{meta.map((m) => <span>{m}</span>)}</p>}
      <H class="ecard__title">{data.title}</H>
      {data.summary && <p class="ecard__sum">{data.summary}</p>}
      {wide && <span class="ecard__more">Scopri l'evento</span>}
    </div>
  </a>
) : (
  <a class:list={['ticket', `tone-${tone}`]} href={u(`/eventi/${id}/`)}>
    <span class="ticket__main">
      {meta.length > 0 && <span class="ticket__meta">{meta.join(', ')}</span>}
      <H class="ticket__title">{data.title}</H>
    </span>
    <span class="ticket__stub" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </span>
  </a>
)}

<style>
  .ecard { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; color: var(--ink); text-decoration: none; background: #fff; height: 100%; }
  .ecard:hover { color: var(--ink); border-color: #b9bfca; }
  .ecard__img { aspect-ratio: 4 / 3; }
  .ecard__body { padding: 22px; display: flex; flex-direction: column; gap: 8px; }
  .ecard__meta { display: flex; flex-wrap: wrap; gap: 6px; font-size: 13px; font-weight: 600; color: var(--red-dark); }
  .ecard__meta span + span::before { content: ''; display: inline-block; width: 4px; height: 4px; border-radius: 50%; background: currentColor; margin: 0 8px 3px 2px; vertical-align: middle; }
  .ecard__title { font-size: 22px; font-weight: 700; }
  .ecard__sum { color: var(--muted); font-size: 15px; }
  .ecard__more { margin-top: 8px; font-weight: 600; color: var(--red-dark); text-decoration: underline; text-underline-offset: 3px; }
  .ecard--wide { display: grid; grid-template-columns: minmax(0, 300px) minmax(0, 1fr); align-items: center; background: var(--tint-yellow); border-color: transparent; }
  .ecard--wide .ecard__img { aspect-ratio: 3 / 4; }
  .ecard--wide .ecard__body { padding: 32px 40px; gap: 12px; }
  .ecard--wide .ecard__title { font-size: clamp(26px, 3vw, 36px); font-weight: 800; }
  .ecard--wide .ecard__sum { font-size: 17px; color: #3d4350; max-width: 520px; }
  @media (max-width: 700px) { .ecard--wide { grid-template-columns: minmax(0, 1fr); } .ecard--wide .ecard__img { aspect-ratio: 4 / 3; } .ecard--wide .ecard__body { padding: 22px; } }

  /* Events without a photo look like a ticket: an event is something you take part in. */
  .ticket {
    --notch: var(--ticket-bg, #fff);
    position: relative; display: grid; grid-template-columns: minmax(0, 1fr) 64px; min-height: 118px;
    background: var(--tone-tint); color: var(--ink); text-decoration: none; border-radius: 18px;
    transition: transform .18s ease, box-shadow .18s ease;
  }
  .ticket::before, .ticket::after { content: ''; position: absolute; right: 52px; width: 24px; height: 24px; border-radius: 50%; background: var(--notch); }
  .ticket::before { top: -12px; }
  .ticket::after { bottom: -12px; }
  .ticket:hover { color: var(--ink); transform: translateY(-2px) rotate(-.4deg); box-shadow: 0 10px 24px rgba(27, 31, 42, 0.1); }
  .ticket__main { padding: 20px 22px; display: flex; flex-direction: column; justify-content: center; gap: 6px; }
  .ticket__meta { font-size: 13px; font-weight: 600; color: var(--tone-ink); }
  .ticket__title { font-family: var(--font-head); font-size: 21px; font-weight: 700; line-height: 1.15; letter-spacing: -0.01em; }
  .ticket__stub { display: grid; place-items: center; border-left: 2px dashed rgba(27, 31, 42, 0.2); color: var(--tone-ink); }
  @media (prefers-reduced-motion: reduce) { .ticket { transition: none; } .ticket:hover { transform: none; } }
</style>
