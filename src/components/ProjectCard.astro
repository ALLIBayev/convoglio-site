---
import Media from './Media.astro';
import { u, isExternal } from '../lib/url';

interface Props {
  id: string;
  data: { title: string; summary: string; image: string; imageAlt: string; imageFit: 'cover' | 'contain'; color: string; link: string };
  headingLevel?: 'h2' | 'h3';
}
const { id, data, headingLevel = 'h3' } = Astro.props;
const href = data.link ? u(data.link) : u(`/progetti/${id}/`);
const ext = isExternal(data.link);
const H = headingLevel;
---
<a class:list={['pcard', !data.image && `pcard--plain pcard--${data.color}`]} href={href} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined}>
  {data.image && (
    <div class="pcard__img"><Media src={data.image} alt={data.imageAlt} tone={data.color} fit={data.imageFit} /></div>
  )}
  <div class="pcard__body">
    <H class="pcard__title">{data.title}</H>
    {data.summary && <p>{data.summary}</p>}
    <span class="pcard__more">{ext ? 'Apri il sito (nuova scheda)' : 'Scopri il progetto'}</span>
  </div>
</a>

<style>
  .pcard { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; text-decoration: none; color: var(--ink); background: #fff; transition: border-color .15s; min-height: 100%; }
  .pcard:hover { color: var(--ink); border-color: #b9bfca; }
  .pcard__img { aspect-ratio: 16 / 10; }
  .pcard__body { padding: 22px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .pcard__title { font-family: var(--font-head); font-size: 21px; font-weight: 600; letter-spacing: -0.01em; }
  .pcard p { font-size: 15px; color: var(--muted); }
  .pcard__more { margin-top: auto; padding-top: 10px; font-size: 14px; font-weight: 600; color: var(--teal); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .pcard--plain { border-color: transparent; min-height: 168px; }
  .pcard--plain .pcard__body { padding: 26px 24px 22px; }
  .pcard--plain .pcard__title { font-size: 24px; font-weight: 800; }
  .pcard--blue { background: var(--tint-sky); }
  .pcard--yellow { background: var(--tint-yellow); }
  .pcard--red { background: var(--tint-red); }
  .pcard--green { background: var(--tint-mint); }
  .pcard--dark { background: var(--night); color: #fff; }
  .pcard--dark p { color: #cfd3db; }
  .pcard--dark .pcard__more { color: var(--yellow); }
  .pcard--plain:hover { border-color: rgba(27, 31, 42, 0.35); }
  .pcard--dark:hover { color: #fff; }
</style>
