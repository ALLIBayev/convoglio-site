---
interface Props { size?: number; mono?: boolean; class?: string }
const { size = 44, mono = false, class: cls } = Astro.props;
const h = Math.round((size * 28) / 44);
const c = mono ? ['currentColor', 'currentColor', 'currentColor'] : ['#C8401F', '#F2B33D', '#0E6E66'];
const w = mono ? 'currentColor' : '#1B1F2A';
---
<svg class={cls} width={size} height={h} viewBox="0 0 44 28" fill="none" aria-hidden="true">
  <rect x="1" y="4" width="12" height="16" rx="4" fill={c[0]} opacity={mono ? 0.55 : 1} />
  <rect x="16" y="4" width="12" height="16" rx="4" fill={c[1]} opacity={mono ? 0.75 : 1} />
  <rect x="31" y="4" width="12" height="16" rx="4" fill={c[2]} />
  <circle cx="7" cy="24" r="3" fill={w} />
  <circle cx="22" cy="24" r="3" fill={w} />
  <circle cx="37" cy="24" r="3" fill={w} />
</svg>
