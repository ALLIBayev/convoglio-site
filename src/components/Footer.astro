---
import site from '../content/settings/site.json';
import { u, telHref } from '../lib/url';
const year = new Date().getFullYear();
---
<footer class="ftr" id="contatti">
  <div class="wrap">
    <div class="ftr__grid">
      <div>
        <p class="ftr__name">{site.name}</p>
        <p class="ftr__txt">Associazione di volontariato.<br />C.F. {site.fiscalCode}</p>
      </div>
      <div>
        <h2 class="ftr__h">Sede</h2>
        <p class="ftr__txt">{site.address}<br />{site.addressNote}</p>
      </div>
      <div>
        <h2 class="ftr__h">Contatti</h2>
        <ul class="ftr__list">
          <li><a href={telHref(site.phone)}>{site.phone}</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        </ul>
      </div>
      <div>
        <h2 class="ftr__h">Seguici</h2>
        <ul class="ftr__list">
          {site.facebook && <li><a href={site.facebook} rel="noopener" target="_blank">Facebook</a></li>}
          {site.instagram && <li><a href={site.instagram} rel="noopener" target="_blank">Instagram</a></li>}
        </ul>
      </div>
    </div>
    <div class="ftr__bottom">
      <span>© {year} {site.legalName}</span>
      <span class="ftr__legal">
        {site.documentsLink && <><a href={u(site.documentsLink)}>Documenti</a> · </>}
        <a href={u('/privacy/')}>Privacy</a>
      </span>
    </div>
  </div>
</footer>

<style>
  .ftr { background: var(--night); color: #c9ced8; padding: 64px 0 32px; font-size: 15px; }
  .ftr a { color: #c9ced8; }
  .ftr a:hover { color: #fff; }
  .ftr__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 32px; }
  .ftr__name { font-family: var(--font-head); font-weight: 800; font-size: 24px; color: #fff; margin-bottom: 12px; }
  .ftr__h { font-family: var(--font-body); font-size: 15px; font-weight: 600; color: #fff; margin-bottom: 12px; letter-spacing: 0; }
  .ftr__txt { line-height: 1.8; }
  .ftr__list { list-style: none; margin: 0; padding: 0; line-height: 2; }
  .ftr__bottom { border-top: 1px solid #343a4a; margin-top: 40px; padding-top: 24px; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; font-size: 14px; color: #9aa1ae; }
</style>
