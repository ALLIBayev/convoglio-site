---
import Base from '../layouts/Base.astro';
import Media from './Media.astro';
import site from '../content/settings/site.json';
import it from '../content/cirillico/it.json';
import ru from '../content/cirillico/ru.json';
import en from '../content/cirillico/en.json';
import { u, isExternal } from '../lib/url';

interface Props { lang: 'it' | 'ru' | 'en' }
const { lang } = Astro.props;
const t = { it, ru, en }[lang];
const paths = { it: '/cirillico/', ru: '/cirillico/ru/', en: '/cirillico/en/' };
const alternates = [
  { lang: 'it', href: paths.it },
  { lang: 'ru', href: paths.ru },
  { lang: 'en', href: paths.en },
  { lang: 'x-default', href: paths.it },
];
const ext = (h: string) => (isExternal(h) ? { target: '_blank', rel: 'noopener' } : {});
const image = t.heroImage || it.heroImage || undefined;
---
<Base title={t.seoTitle} description={t.seoDescription} lang={lang} alternates={alternates} chrome={false} image={image}>
  <section class="hero">
    <div class="wrap">
      <div class="bar">
        <a class="crumb" href={u('/progetti/')}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
          <strong>ConVoglio</strong><span>/ {t.back}</span>
        </a>
        <nav class="langs" aria-label="Lingua / Язык / Language">
          {(['it', 'ru', 'en'] as const).map((l) => (
            <a href={u(paths[l])} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a>
          ))}
        </nav>
      </div>

      <div class="hero__grid">
        <div class="hero__copy">
          <ul class="tags">
            {t.tags.map((tag, i) => <li class={i < 2 ? 'tag tag--y' : 'tag'}>{tag}</li>)}
          </ul>
          <h1>USPR<br />Cirillico</h1>
          <p class="sub">{t.subtitle}</p>
          <p class="hero__lead">{t.lead}</p>
          <div class="row">
            <a class="btn btn--yellow" href={t.joinLink} {...ext(t.joinLink)}>{t.ctaJoin}</a>
            <a class="btn btn--line" href="#storia">{t.ctaStory}</a>
          </div>
        </div>
        <div class="hero__media"><Media src={t.heroImage || it.heroImage} alt={t.heroImageAlt} tone="dark" eager /></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="kicker">{t.whoKicker}</p>
      <h2 class="h2">{t.whoTitle}</h2>
      <p class="lead">{t.whoLead}</p>
      <div class="grid grid--4 groups">
        {t.groups.map((g) => (
          <article class="card card--soft group">
            <span class="code">{g.code}</span>
            <h3>{g.title}</h3>
            <p>{g.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft" id="storia">
    <div class="wrap story">
      <div>
        <p class="kicker">{t.storyKicker}</p>
        <h2 class="h2">{t.storyTitle}</h2>
      </div>
      <ol class="timeline">
        {t.timeline.map((s) => (
          <li><span class="year">{s.year}</span><p>{s.text}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="press__title">{t.pressTitle}</h2>
      <ul class="press">
        {t.press.map((p) => (
          <li>{p.url ? <a href={p.url} target="_blank" rel="noopener">{p.name}</a> : <span>{p.name}</span>}</li>
        ))}
      </ul>

      <div class="join">
        <div>
          <h2>{t.joinTitle}</h2>
          <p>{t.joinText}</p>
        </div>
        <div class="row">
          <a class="btn btn--yellow" href={t.joinLink} {...ext(t.joinLink)}>{t.joinButton}</a>
          {t.ethicsLink && <a class="btn btn--line" href={u(t.ethicsLink)} {...ext(t.ethicsLink)}>{t.ethicsButton}</a>}
        </div>
      </div>
    </div>
  </section>

  <footer slot="footer" class="cfoot">
    <div class="wrap cfoot__in">
      <span>{t.footer} · C.F. {site.fiscalCode}</span>
      <span class="cfoot__links">
        {t.instagram && <a href={t.instagram} target="_blank" rel="noopener">Instagram</a>}
        {t.facebook && <a href={t.facebook} target="_blank" rel="noopener">Facebook</a>}
        <a href={u('/')}>ConVoglio</a>
        <a href={u('/privacy/')}>Privacy</a>
      </span>
    </div>
  </footer>
</Base>

<style>
  .row { display: flex; gap: 12px; flex-wrap: wrap; }
  .hero { background: var(--night); color: #fff; padding: 20px 0 96px; }
  .bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; min-height: 64px; margin-bottom: 48px; }
  .crumb { display: inline-flex; align-items: center; gap: 8px; color: #fff; text-decoration: none; min-height: 44px; }
  .crumb:hover { color: var(--yellow); }
  .crumb strong { font-family: var(--font-head); font-size: 20px; }
  .crumb span { color: #aeb4c0; }
  .langs { display: flex; gap: 4px; background: var(--night-2); padding: 4px; border-radius: 999px; }
  .langs a { min-width: 48px; min-height: 44px; display: grid; place-items: center; padding: 0 12px; border-radius: 999px; color: #d5d9e0; text-decoration: none; font-weight: 600; font-size: 14px; }
  .langs a:hover { color: #fff; }
  .langs a[aria-current='true'] { background: var(--yellow); color: var(--ink); }
  .hero__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 56px; align-items: center; }
  .hero__copy { display: flex; flex-direction: column; gap: 20px; }
  .tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tag { font-size: 13px; font-weight: 600; padding: 6px 12px; border-radius: 999px; border: 1px solid #4a5163; color: #d5d9e0; }
  .tag--y { background: var(--yellow); border-color: var(--yellow); color: var(--ink); }
  h1 { font-size: clamp(56px, 7.5vw, 88px); font-weight: 800; line-height: 0.95; }
  .sub { color: var(--yellow); font-weight: 600; letter-spacing: 0.14em; font-size: 14px; }
  .hero__lead { font-size: 20px; color: #d5d9e0; max-width: 520px; }
  .hero__media { height: 460px; border-radius: 28px; overflow: hidden; }

  .groups { margin-top: 40px; }
  .group { display: flex; flex-direction: column; gap: 8px; padding: 28px; }
  .code { font-family: var(--font-head); font-size: 34px; font-weight: 800; color: var(--red); }
  .group h3 { font-size: 20px; margin: 0; }

  .story { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 48px; align-items: start; }
  .timeline { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .timeline li { background: #fff; border-radius: 18px; padding: 22px 24px; display: grid; grid-template-columns: 64px 1fr; gap: 20px; align-items: baseline; }
  .year { font-family: var(--font-head); font-weight: 800; font-size: 24px; color: var(--teal); }

  .press__title { font-family: var(--font-body); font-size: 18px; font-weight: 600; color: var(--muted); margin-bottom: 20px; }
  .press { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr)); gap: 12px; }
  .press li > * { min-height: 92px; border: 1px solid var(--line); border-radius: 18px; display: grid; place-items: center; text-align: center; padding: 12px; font-family: Georgia, 'Times New Roman', serif; font-weight: 700; font-size: 20px; color: var(--ink); text-decoration: none; }
  .press li > a:hover { border-color: var(--ink); color: var(--ink); }

  .join { margin-top: 56px; background: var(--red); color: #fff; border-radius: 28px; padding: 48px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 24px; align-items: center; }
  .join h2 { font-size: clamp(30px, 3.4vw, 40px); font-weight: 800; margin-bottom: 8px; }
  .join p { color: #fde7e0; }

  .cfoot { background: var(--night); color: #aeb4c0; padding: 28px 0; font-size: 14px; }
  .cfoot__in { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .cfoot__links { display: flex; gap: 16px; flex-wrap: wrap; }
  .cfoot a { color: #d5d9e0; }
  .cfoot a:hover { color: #fff; }

  @media (max-width: 600px) {
    .hero { padding-bottom: 64px; }
    .bar { margin-bottom: 32px; }
    .crumb span { display: none; }
    .hero__media { height: 280px; }
    .hero__lead { font-size: 18px; }
    .timeline li { grid-template-columns: 1fr; gap: 6px; }
    .join { padding: 32px 22px; }
    .groups { grid-template-columns: 1fr 1fr; gap: 10px; }
    .group { padding: 20px 16px; }
    .group h3 { font-size: 17px; }
    .code { font-size: 28px; }
    .press { grid-template-columns: 1fr 1fr; }
    .press li > * { min-height: 72px; font-size: 17px; }
  }
</style>
