---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import PageHead from '../../components/PageHead.astro';
import EventCard from '../../components/EventCard.astro';
import site from '../../content/settings/site.json';
import { u } from '../../lib/url';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((e) => ({ params: { id: e.id }, props: { e, all: events } }));
}
const { e, all } = Astro.props;
const { Content } = await render(e);
const hasBody = !!e.body?.trim();
const meta = [e.data.category, e.data.date].filter(Boolean).join(', ');
const description = e.data.summary || `${e.data.title}: un evento solidale di ConVoglio OdV a Torino.`;
const others = all.filter((x) => x.id !== e.id && !x.data.image).sort((a, b) => a.data.order - b.data.order).slice(0, 4);
const tones = ['yellow', 'blue', 'green', 'red'];
---
<Base title={`${e.data.title} · Eventi ConVoglio OdV`} description={description} image={e.data.image || undefined}>
  <PageHead tone="red" kicker={meta || 'Evento'} title={e.data.title} lead={e.data.summary || undefined} crumbs={[{ label: 'Eventi', href: '/eventi/' }, { label: e.data.title }]}>
    {e.data.place && <p class="place"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12Z" /><circle cx="12" cy="9" r="2.5" /></svg>{e.data.place}</p>}
  </PageHead>

  <section class="wrap detail">
    <div class:list={['detail__grid', !e.data.image && 'detail__grid--solo']}>
      <div>
        {hasBody ? (
          <div class="prose"><Content /></div>
        ) : (
          <div class="empty">
            <h2>Vuoi partecipare al prossimo evento?</h2>
            <p>Annunciamo date e programmi su Instagram e Facebook. Oppure scrivici: ti teniamo un posto a bordo.</p>
            <div class="row">
              {site.instagram && <a class="btn btn--primary" href={site.instagram} target="_blank" rel="noopener">Seguici su Instagram</a>}
              <a class="btn btn--ghost" href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Ciao! Vorrei informazioni su ' + e.data.title)}`} target="_blank" rel="noopener">WhatsApp</a>
            </div>
          </div>
        )}
      </div>
      {e.data.image && <div class="detail__media"><Media src={e.data.image} alt={e.data.imageAlt} tone="yellow" fit={e.data.imageFit} eager /></div>}
    </div>
  </section>

  <section class="section section--soft">
    <div class="wrap" style="--ticket-bg: var(--soft)">
      <div class="section-head">
        <h2 class="h2">Altri eventi</h2>
        <a class="btn btn--ghost" href={u('/eventi/')}>Tutti gli eventi</a>
      </div>
      <div class="grid grid--2 others">
        {others.map((o, i) => <EventCard id={o.id} data={o.data} tone={tones[i % 4]} headingLevel="h3" />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .place { display: inline-flex; align-items: center; gap: 8px; margin-top: 18px; font-weight: 600; background: #fff; padding: 8px 14px; border-radius: 999px; }
  .detail { padding-top: 56px; padding-bottom: 80px; }
  .detail__grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 48px; align-items: start; }
  .detail__grid--solo { grid-template-columns: minmax(0, 1fr); max-width: 820px; }
  .detail__media { aspect-ratio: 3 / 4; border-radius: var(--radius-lg); overflow: hidden; background: var(--tint-yellow); }
  .empty { background: var(--tint-red); border-radius: var(--radius-lg); padding: 40px; display: flex; flex-direction: column; gap: 14px; }
  .empty h2 { font-size: 28px; font-weight: 800; }
  .empty p { color: #3d4350; }
  .row { margin-top: 6px; }
  .others { gap: 20px 16px; }
  @media (max-width: 800px) { .detail__grid { grid-template-columns: minmax(0, 1fr); } .detail__media { order: -1; max-width: 460px; } }
  @media (max-width: 600px) { .detail { padding-top: 32px; padding-bottom: 56px; } .empty { padding: 28px 22px; } }
</style>
