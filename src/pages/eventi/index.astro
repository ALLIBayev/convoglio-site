---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EventCard from '../../components/EventCard.astro';
import home from '../../content/settings/home.json';

const events = (await getCollection('events')).sort((a, b) => a.data.order - b.data.order);
const tones = ['yellow', 'blue', 'red', 'green'];
---
<Base title="Eventi · ConVoglio OdV" description="Spettacoli, concerti, corse e feste per bambini: gli eventi solidali di ConVoglio OdV a Torino.">
  <header class="wrap page-head">
    <p class="kicker">Eventi</p>
    <h1 class="h1">{home.events.title}</h1>
    <p class="lead">{home.events.lead}</p>
  </header>
  <section class="wrap list-wrap">
    <div class="grid grid--3 list">
      {events.map((e, i) => <EventCard id={e.id} data={e.data} tone={tones[i % 4]} />)}
    </div>
  </section>
</Base>

<style>
  .list-wrap { padding-bottom: 96px; }
  .list { gap: 16px; align-items: start; }
  @media (max-width: 600px) { .list-wrap { padding-bottom: 64px; } }
</style>
