---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import PageHead from '../../components/PageHead.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import site from '../../content/settings/site.json';
import { u } from '../../lib/url';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  // Projects with a page of their own (Cirillico) or an external site don't get a generic page.
  return projects.filter((p) => !p.data.link).map((p) => ({ params: { id: p.id }, props: { p, all: projects } }));
}
const { p, all } = Astro.props;
const { Content } = await render(p);
const hasBody = !!p.body?.trim();
const description = p.data.summary || `${p.data.title}: un progetto di ConVoglio OdV, organizzazione di volontariato a Torino.`;
const others = all.filter((x) => x.id !== p.id && !x.data.image).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
---
<Base title={`${p.data.title} · ConVoglio OdV`} description={description} image={p.data.image || undefined}>
  <PageHead tone="blue" kicker="Progetto" title={p.data.title} lead={p.data.summary || undefined} crumbs={[{ label: 'Progetti', href: '/progetti/' }, { label: p.data.title }]} />

  <section class="wrap detail">
    <div class:list={['detail__grid', !p.data.image && 'detail__grid--solo']}>
      <div>
        {hasBody ? (
          <div class="prose"><Content /></div>
        ) : (
          <div class="empty">
            <h2>Vuoi saperne di più su {p.data.title}?</h2>
            <p>Scrivici: ti raccontiamo come funziona il progetto e come puoi dare una mano.</p>
            <div class="row">
              <a class="btn btn--primary" href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Ciao! Vorrei sapere di più sul progetto ' + p.data.title)}`} target="_blank" rel="noopener">Scrivici su WhatsApp</a>
              <a class="btn btn--ghost" href={`mailto:${site.email}?subject=${encodeURIComponent(p.data.title)}`}>Email</a>
            </div>
          </div>
        )}
      </div>
      {p.data.image && <div class="detail__media"><Media src={p.data.image} alt={p.data.imageAlt} tone={p.data.color} fit={p.data.imageFit} eager /></div>}
    </div>
  </section>

  <section class="section section--soft">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h2">Altri progetti</h2>
        <a class="btn btn--ghost" href={u('/progetti/')}>Tutti i progetti</a>
      </div>
      <div class="grid grid--3">
        {others.map((o) => <ProjectCard id={o.id} data={o.data} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .detail { padding-top: 56px; padding-bottom: 80px; }
  .detail__grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 48px; align-items: start; }
  .detail__grid--solo { grid-template-columns: minmax(0, 1fr); max-width: 820px; }
  .detail__media { aspect-ratio: 4 / 3; border-radius: var(--radius-lg); overflow: hidden; }
  .empty { background: var(--tint-sky); border-radius: var(--radius-lg); padding: 40px; display: flex; flex-direction: column; gap: 14px; }
  .empty h2 { font-size: 28px; font-weight: 800; }
  .empty p { color: #3d4350; }
  .row { margin-top: 6px; }
  @media (max-width: 800px) { .detail__grid { grid-template-columns: minmax(0, 1fr); } .detail__media { order: -1; } }
  @media (max-width: 600px) { .detail { padding-top: 32px; padding-bottom: 56px; } .empty { padding: 28px 22px; } }
</style>
