---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Progetti · ConVoglio OdV" description="Tutti i progetti di ConVoglio OdV, organizzazione di volontariato a Torino.">
  <header class="wrap page-head">
    <p class="kicker">Progetti</p>
    <h1 class="h1">I nostri progetti</h1>
    <p class="lead">Sport, feste, iniziative solidali: ecco tutti i progetti che portiamo avanti con i nostri volontari.</p>
  </header>
  <section class="wrap list-wrap">
    <div class="grid grid--3 list">
      {projects.map((p) => <ProjectCard id={p.id} data={p.data} headingLevel="h2" />)}
    </div>
  </section>
</Base>

<style>
  .list-wrap { padding-bottom: 96px; }
  @media (max-width: 600px) { .list-wrap { padding-bottom: 64px; } }
</style>
