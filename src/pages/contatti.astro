---
import Base from '../layouts/Base.astro';
import site from '../content/settings/site.json';
import { telHref } from '../lib/url';
---
<Base title="Contatti · ConVoglio OdV" description={`Contatta ConVoglio OdV: ${site.phone}, ${site.email}. Sede in ${site.address}.`}>
  <header class="wrap page-head">
    <p class="kicker">Contatti</p>
    <h1 class="h1">Scrivici, chiamaci o passa a trovarci.</h1>
    <p class="lead">Per eventi, collaborazioni, donazioni o per entrare in squadra come volontario.</p>
  </header>

  <section class="wrap contacts">
    <a class="ct ct--red" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">
      <span class="ct__label">WhatsApp e telefono</span>
      <span class="ct__value">{site.phone}</span>
      <span class="ct__hint">Apri la chat</span>
    </a>
    <a class="ct ct--sky" href={`mailto:${site.email}`}>
      <span class="ct__label">Email</span>
      <span class="ct__value ct__value--sm">{site.email}</span>
      <span class="ct__hint">Scrivi un'email</span>
    </a>
    <a class="ct ct--mint" href={site.mapsLink} target="_blank" rel="noopener">
      <span class="ct__label">Sede</span>
      <span class="ct__value ct__value--sm">{site.address}</span>
      <span class="ct__hint">{site.addressNote}. Apri in Google Maps</span>
    </a>
    <div class="ct ct--yellow">
      <span class="ct__label">Seguici</span>
      <span class="ct__links">
        {site.instagram && <a class="btn btn--ghost" href={site.instagram} target="_blank" rel="noopener">Instagram</a>}
        {site.facebook && <a class="btn btn--ghost" href={site.facebook} target="_blank" rel="noopener">Facebook</a>}
      </span>
      <span class="ct__hint">Annunciamo lì i prossimi eventi.</span>
    </div>
  </section>
  <p class="wrap tel">Preferisci chiamare? <a href={telHref(site.phone)}>{site.phone}</a></p>
</Base>

<style>
  .contacts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .ct { display: flex; flex-direction: column; gap: 8px; border-radius: var(--radius); padding: 28px; color: var(--ink); text-decoration: none; min-height: 190px; border: 1px solid transparent; }
  a.ct:hover { color: var(--ink); border-color: rgba(27, 31, 42, 0.35); }
  .ct--red { background: var(--tint-red); }
  .ct--sky { background: var(--tint-sky); }
  .ct--mint { background: var(--tint-mint); }
  .ct--yellow { background: var(--tint-yellow); }
  .ct__label { font-weight: 600; color: var(--muted); font-size: 15px; }
  .ct__value { font-family: var(--font-head); font-weight: 800; font-size: clamp(26px, 3vw, 34px); line-height: 1.1; overflow-wrap: anywhere; }
  .ct__value--sm { font-size: clamp(22px, 2.4vw, 28px); }
  .ct__hint { margin-top: auto; font-size: 15px; color: var(--muted); }
  a.ct .ct__hint { text-decoration: underline; text-underline-offset: 3px; }
  .ct__links { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 4px; }
  .tel { padding-top: 24px; padding-bottom: 96px; color: var(--muted); }
  @media (max-width: 700px) { .contacts { grid-template-columns: 1fr; } .ct { min-height: 0; padding: 22px; } .tel { padding-bottom: 64px; } }
</style>
