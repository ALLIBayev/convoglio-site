---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import site from '../content/settings/site.json';
import { u } from '../lib/url';
---
<Base title="Documenti · ConVoglio OdV" description="Statuto e documenti ufficiali di ConVoglio OdV.">
  <PageHead tone="soft" kicker="Documenti" title="Documenti dell'associazione" lead={`Statuto e informative ufficiali di ${site.legalName}, C.F. ${site.fiscalCode}.`} crumbs={[{ label: 'Chi siamo', href: '/organizzazione/' }, { label: 'Documenti' }]} />
  <section class="wrap docs-wrap">
    <ul class="docs">
      {site.documents.map((d) => (
        <li class="doc">
          <span class="doc__title">{d.title}</span>
          {d.file ? (
            <a class="btn btn--ghost" href={u(d.file)} target="_blank" rel="noopener">Apri il PDF</a>
          ) : (
            <a class="btn btn--ghost" href={`mailto:${site.email}?subject=${encodeURIComponent('Richiesta: ' + d.title)}`}>Richiedilo via email</a>
          )}
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .docs-wrap { padding-top: 48px; padding-bottom: 96px; }
  .docs { list-style: none; margin: 0; padding: 0; max-width: 820px; border-top: 1px solid var(--line); }
  .doc { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 0; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
  .doc__title { font-weight: 600; font-size: 18px; }
  @media (max-width: 600px) { .docs-wrap { padding-bottom: 64px; } }
</style>
