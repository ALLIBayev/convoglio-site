---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import site from '../content/settings/site.json';
import { u } from '../lib/url';
---
<Base title="Diventa socio · ConVoglio OdV" description="Come diventare socio di ConVoglio OdV: compila la domanda di ammissione e versa la quota associativa.">
  <PageHead tone="red" kicker="Iscrizioni" title="Vuoi diventare socio e fare del bene?" lead="Bastano due passaggi. Se hai dubbi, scrivici: ti rispondiamo noi." crumbs={[{ label: 'Sostienici', href: '/sostienici/' }, { label: 'Diventa socio' }]} />

  <section class="wrap steps-wrap">
    <ol class="steps">
      <li class="step">
        <span class="step__n" aria-hidden="true">1</span>
        <div>
          <h2>Compila la domanda di ammissione</h2>
          <p>Un breve questionario online con i tuoi dati.</p>
          {site.membershipForm && <p class="cta"><a class="btn btn--primary" href={site.membershipForm} target="_blank" rel="noopener">Apri la domanda di ammissione</a></p>}
        </div>
      </li>
      <li class="step">
        <span class="step__n" aria-hidden="true">2</span>
        <div>
          <h2>Versa la quota associativa</h2>
          <p>Con bonifico, Satispay o PayPal. Trovi tutti i dati nella pagina Sostienici.</p>
          <p class="cta"><a class="btn btn--ghost" href={u('/sostienici/#dona')}>Vedi come pagare</a></p>
        </div>
      </li>
    </ol>
    <p class="help">Domande? Scrivi a <a href={`mailto:${site.email}`}>{site.email}</a> o su <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a>.</p>
  </section>
</Base>

<style>
  .steps-wrap { padding-top: 48px; padding-bottom: 96px; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; max-width: 820px; }
  .step { display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 20px; background: var(--soft); border-radius: var(--radius); padding: 28px; }
  .step__n { width: 56px; height: 56px; border-radius: 50%; background: var(--red); color: #fff; display: grid; place-items: center; font-family: var(--font-head); font-weight: 800; font-size: 24px; }
  .step h2 { font-size: 24px; font-weight: 700; margin-bottom: 6px; }
  .step p { color: var(--muted); }
  .cta { margin-top: 18px; }
  .help { margin-top: 32px; color: var(--muted); }
  @media (max-width: 600px) { .step { grid-template-columns: 1fr; padding: 22px; gap: 12px; } .step__n { width: 44px; height: 44px; font-size: 20px; } .steps-wrap { padding-bottom: 64px; } }
</style>
