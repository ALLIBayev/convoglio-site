---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CopyField from '../components/CopyField.astro';
import Partners from '../components/Partners.astro';
import site from '../content/settings/site.json';
import home from '../content/settings/home.json';
import { u } from '../lib/url';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.find((p) => p.data.featured) ?? projects[0];
const rest = projects.filter((p) => p !== featured);
const cards = rest.slice(0, 4);
const chips = rest.slice(4);

const events = (await getCollection('events')).sort((a, b) => a.data.order - b.data.order);
const shownEvents = events.slice(0, 6);

const pillarIcons = ['coins', 'users', 'sprout'] as const;
const pillarTones = ['red', 'yellow', 'green'];
const featuredHref = featured.data.link ? u(featured.data.link) : u(`/progetti/${featured.id}/`);
const hero = home.hero as typeof home.hero & { imageFit?: 'cover' | 'contain' };
---
<Base title={home.seoTitle}>
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="badge">{hero.badge}</p>
        <h1>{hero.title}</h1>
        <p class="hero__lead">{hero.lead}</p>
        <div class="row">
          <a class="btn btn--primary" href={u('/sostienici/')}>Sostienici</a>
          <a class="btn btn--ghost" href="#progetti">Scopri i progetti</a>
        </div>
      </div>
      <div class="hero__media">
        <Media src={hero.image} alt={hero.imageAlt} fit={hero.imageFit ?? 'cover'} tone="blue" eager width={960} height={865} />
        <a class="hero__chip" href={u('/sostienici/#cinque-per-mille')}>
          <span class="hero__chip-ic"><Icon name="heart" size={20} /></span>
          <span><strong>Dona il tuo 5×1000</strong><br /><small>Codice fiscale {site.fiscalCode}</small></span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--soft" id="chi-siamo">
    <div class="wrap">
      <p class="kicker">Chi siamo</p>
      <h2 class="h2">{home.about.title}</h2>
      <p class="lead">{home.about.lead}</p>
      <div class="grid grid--3 pillars">
        {home.about.pillars.map((p, i) => (
          <article class="card">
            <span class={`pill-ic pill-ic--${pillarTones[i % 3]}`}><Icon name={pillarIcons[i % 3]} /></span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
      <p class="after"><a class="more" href={u('/organizzazione/')}>Leggi chi siamo e come lavoriamo</a></p>
    </div>
  </section>

  <section class="section" id="progetti">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">Progetti</p>
          <h2 class="h2">I nostri progetti</h2>
        </div>
        <a class="more" href={u('/progetti/')}>Tutti gli {projects.length} progetti</a>
      </div>

      <a class="feat" href={featuredHref}>
        <div class="feat__copy">
          <span class="feat__badge">In evidenza</span>
          <h3>{featured.data.title}</h3>
          <p>{featured.data.summary}</p>
          <span class="feat__more">Scopri il progetto</span>
        </div>
        <div class="feat__media"><Media src={featured.data.image} alt={featured.data.imageAlt} fit={featured.data.imageFit} tone="dark" /></div>
      </a>

      <div class="grid grid--4 cards">
        {cards.map((p) => <ProjectCard id={p.id} data={p.data} />)}
      </div>

      {chips.length > 0 && (
        <div class="chips" aria-label="Altri progetti">
          {chips.map((p) => <a class="chip" href={p.data.link ? u(p.data.link) : u(`/progetti/${p.id}/`)}>{p.data.title}</a>)}
        </div>
      )}
    </div>
  </section>

  <section class="section section--soft" id="eventi">
    <div class="wrap ev">
      <div>
        <p class="kicker">Eventi</p>
        <h2 class="h2">{home.events.title}</h2>
        <p class="lead">{home.events.lead}</p>
        <p class="after"><a class="btn btn--ghost" href={u('/eventi/')}>Tutti i {events.length} eventi</a></p>
      </div>
      <ul class="ev__list">
        {shownEvents.map((e) => (
          <li>
            <a href={u(`/eventi/${e.id}/`)}>
              <strong>{e.data.title}</strong>
              {(e.data.category || e.data.date) && <span>{e.data.date || e.data.category}</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="sostienici">
    <div class="wrap">
      <p class="kicker">Sostienici</p>
      <h2 class="h2 support__title">{home.support.title}</h2>
      <div class="grid grid--3">
        <article class="card support support--red">
          <h3>{home.support.fiveTitle}</h3>
          <p>{home.support.fiveText}</p>
          <div class="support__foot"><CopyField value={site.fiscalCode} label="codice fiscale" variant="onred" /></div>
        </article>
        <article class="card card--soft support">
          <h3>{home.support.donateTitle}</h3>
          <p>{home.support.donateText}</p>
          <div class="support__foot row">
            <a class="btn btn--primary" href={u('/sostienici/#dona')}>Dona ora</a>
            {site.donations.satispay && <a class="btn btn--ghost" href={site.donations.satispay} target="_blank" rel="noopener">Satispay</a>}
          </div>
        </article>
        <article class="card card--soft support">
          <h3>{home.support.volunteerTitle}</h3>
          <p>{home.support.volunteerText}</p>
          <div class="support__foot row">
            <a class="btn btn--ghost" href={u('/iscrizioni/')}>Diventa socio</a>
          </div>
        </article>
      </div>

      <Partners />

      <div class="news">
        <div>
          <h2>{home.newsletter.title}</h2>
          <p>{home.newsletter.text}</p>
        </div>
        <div class="row news__btns">
          {site.instagram && <a class="btn btn--yellow" href={site.instagram} target="_blank" rel="noopener">Instagram</a>}
          {site.facebook && <a class="btn btn--line" href={site.facebook} target="_blank" rel="noopener">Facebook</a>}
          <a class="btn btn--line" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .badge { align-self: flex-start; background: var(--tint-yellow); color: #6b4a00; font-weight: 600; font-size: 15px; padding: 8px 14px; border-radius: 999px; }

  .hero { padding: 72px 0 96px; }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 56px; align-items: center; }
  .hero__copy { display: flex; flex-direction: column; gap: 26px; }
  .hero h1 { font-size: clamp(44px, 6vw, 76px); font-weight: 800; line-height: 1; letter-spacing: -0.025em; }
  .hero__lead { font-size: 20px; color: var(--muted); max-width: 540px; }
  .hero__media { position: relative; aspect-ratio: 1 / 0.92; border-radius: var(--radius-lg); overflow: hidden; background: var(--tint-sky); }
  .hero__media :global(.media--contain) { padding: 28px 28px 92px; }
  .hero__chip { position: absolute; left: 20px; bottom: 20px; display: flex; gap: 14px; align-items: center; background: #fff; color: var(--ink); text-decoration: none; padding: 12px 20px 12px 12px; border-radius: 18px; box-shadow: 0 12px 32px rgba(27, 31, 42, 0.14); line-height: 1.3; }
  .hero__chip:hover { color: var(--ink); box-shadow: 0 14px 36px rgba(27, 31, 42, 0.22); }
  .hero__chip small { color: var(--muted); font-size: 13px; }
  .hero__chip-ic { width: 44px; height: 44px; border-radius: 12px; background: var(--red); color: #fff; display: grid; place-items: center; flex-shrink: 0; }

  .pillars { margin-top: 48px; }
  .after { margin-top: 32px; }

  .feat { display: grid; grid-template-columns: 1fr 1fr; border-radius: var(--radius-lg); overflow: hidden; background: var(--night); color: #fff; text-decoration: none; }
  .feat:hover { color: #fff; }
  .feat__copy { padding: 56px 48px; display: flex; flex-direction: column; gap: 18px; justify-content: center; }
  .feat__badge { align-self: flex-start; background: var(--yellow); color: var(--ink); font-size: 13px; font-weight: 600; padding: 6px 12px; border-radius: 999px; }
  .feat h3 { font-size: clamp(32px, 3.6vw, 44px); font-weight: 800; }
  .feat p { color: #d5d9e0; font-size: 18px; max-width: 460px; }
  .feat__more { color: var(--yellow); font-weight: 600; text-decoration: underline; text-underline-offset: 4px; }
  .feat__media { min-height: 340px; }
  .cards { margin: 20px 0 24px; }

  .ev { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; align-items: start; }
  .ev__list { list-style: none; margin: 0; padding: 0; background: #fff; border-radius: var(--radius); overflow: hidden; }
  .ev__list li + li { border-top: 1px solid var(--line); }
  .ev__list a { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 18px 24px; color: var(--ink); text-decoration: none; min-height: 60px; }
  .ev__list a:hover { background: var(--soft); }
  .ev__list strong { font-weight: 600; font-size: 17px; }
  .ev__list span { color: var(--muted); font-size: 14px; white-space: nowrap; }

  .support__title { margin-bottom: 40px; }
  .support { display: flex; flex-direction: column; gap: 4px; }
  .support--red { background: var(--red); color: #fff; }
  .support--red p { color: #fff; }
  .support__foot { margin-top: auto; padding-top: 24px; }

  .news { margin-top: 64px; background: var(--teal); color: #fff; border-radius: var(--radius-lg); padding: 48px; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 24px; align-items: center; }
  .news h2 { font-size: 34px; font-weight: 800; margin-bottom: 8px; }
  .news p { color: #d8eee9; max-width: 520px; }

  @media (max-width: 900px) {
    .hero__grid, .ev, .news { grid-template-columns: minmax(0, 1fr); }
    .hero__media { max-width: 560px; }
    .feat { grid-template-columns: 1fr; }
    .feat__media { min-height: 0; aspect-ratio: 4 / 3; order: -1; }
  }
  @media (max-width: 600px) {
    .hero { padding: 32px 0 56px; }
    .hero__copy { gap: 20px; }
    .hero__lead { font-size: 17px; }
    .hero__media :global(.media--contain) { padding: 20px 20px 84px; }
    .hero__chip { left: 12px; right: 12px; bottom: 12px; }
    .feat__copy { padding: 28px 22px 32px; }
    .feat p { font-size: 16px; }
    .news { padding: 32px 22px; }
    .news h2 { font-size: 28px; }
    .ev__list a { flex-direction: column; align-items: flex-start; gap: 2px; padding: 16px 20px; }
  }
</style>
