---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import Partners from '../components/Partners.astro';
import site from '../content/settings/site.json';
import home from '../content/settings/home.json';
import { u } from '../lib/url';

const icons = ['coins', 'users', 'sprout'] as const;
const tones = ['red', 'yellow', 'green'];
---
<Base title="Chi siamo · ConVoglio OdV" description={`${site.legalName}: chi siamo, cosa facciamo e con chi lavoriamo. ${site.motto}.`}>
  <PageHead tone="yellow" kicker="Chi siamo" title={`${site.motto}.`} lead={`${home.about.lead} I fondi raccolti sostengono persone in difficoltà, la ricerca medica, l'ambiente e il contrasto alla violenza.`} crumbs={[{ label: 'Chi siamo' }]} />

  <section class="section section--soft">
    <div class="wrap">
      <h2 class="h2">La nostra missione</h2>
      <div class="grid grid--3 pillars">
        {home.about.pillars.map((p, i) => (
          <article class="card">
            <span class={`pill-ic pill-ic--${tones[i % 3]}`}><Icon name={icons[i % 3]} /></span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap facts">
      <div>
        <h2 class="h2">Dove siamo</h2>
        <p class="lead">{site.address}, {site.addressNote}.</p>
        <p class="row cta">
          <a class="btn btn--ghost" href={site.mapsLink} target="_blank" rel="noopener">Apri in Google Maps</a>
          <a class="btn btn--ghost" href={u('/contatti/')}>Contatti</a>
        </p>
      </div>
      <dl class="dl">
        <div><dt>Nome</dt><dd>{site.legalName}</dd></div>
        <div><dt>Forma</dt><dd>Organizzazione di volontariato</dd></div>
        <div><dt>Codice fiscale</dt><dd>{site.fiscalCode}</dd></div>
        <div><dt>Documenti</dt><dd><a href={u('/documenti/')}>Statuto e informative</a></dd></div>
      </dl>
    </div>
    <div class="wrap net-wrap"><Partners /></div>
  </section>
</Base>

<style>
  .pillars { margin-top: 40px; }
  .facts { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; align-items: start; }
  .cta { margin-top: 24px; }
  .net-wrap { margin-top: 72px; }
  .dl { margin: 0; border-top: 1px solid var(--line); }
  .dl div { display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .dl dt { color: var(--muted); }
  .dl dd { margin: 0; font-weight: 600; }
  @media (max-width: 800px) {
    .facts { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 480px) { .dl div { grid-template-columns: 1fr; gap: 2px; } }
</style>
